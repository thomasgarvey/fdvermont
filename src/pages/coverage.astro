---
import CoverageMap from "../components/islands/CoverageMap.tsx";
import Analytics from "../components/Analytics.astro";
import Seo from "../components/Seo.astro";
const title = "How far is the nearest fire station? – Vermont Fire Departments";
const description = "A map of Vermont shaded by the straight-line distance to the nearest fire station, and the places furthest from one.";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Seo title={title} description={description} />
    <Analytics />
    <style is:global>
      :root { --c-bg:#fbf9f6; --c-ink:#1f1b18; --c-muted:#5c544d; --c-line:#e2dcd4; --c-card:#fff; --c-accent:#8B211E; }
      @media (prefers-color-scheme: dark) {
        :root { --c-bg:#171412; --c-ink:#eee7df; --c-muted:#a89d92; --c-line:#3a332d; --c-card:#211d1a; --c-accent:#e0726b; }
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; background: var(--c-bg); color: var(--c-ink);
        font: 15px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif; }
      .cov { display: grid; grid-template-columns: 340px 1fr; height: 100vh; }
      .cov aside { overflow: auto; padding: 18px; border-right: 1px solid var(--c-line); }
      .cov .home { font-size: 13px; font-weight: 600; color: var(--c-accent); text-decoration: none; }
      .cov h1 { font-size: 20px; margin: 8px 0 6px; line-height: 1.25; }
      .cov p { margin: 0 0 12px; color: var(--c-muted); }
      .cov a { color: var(--c-accent); }
      .covmap { height: 100%; }
      .cov .legend { display: grid; grid-template-columns: 22px 1fr; gap: 5px 8px; align-items: center; margin: 10px 0 14px; font-size: 13.5px; }
      .cov .sw { width: 22px; height: 14px; border-radius: 3px; border: 1px solid rgba(0,0,0,.12); }
      .cov h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .05em; color: var(--c-muted); margin: 18px 0 8px; }
      .cov ol { margin: 0; padding-left: 22px; }
      .cov li { margin: 0 0 8px; font-size: 14px; cursor: pointer; }
      .cov li:hover b { color: var(--c-accent); }
      .cov li small { display: block; color: var(--c-muted); }
      .cov label { font-size: 14px; display: flex; gap: 8px; align-items: center; }
      .cov .note { font-size: 12.5px; border-top: 1px solid var(--c-line); padding-top: 12px; margin-top: 16px; }
      .cov .stat { display: flex; gap: 10px; margin: 8px 0 4px; }
      .cov .stat div { flex: 1; background: var(--c-card); border: 1px solid var(--c-line); border-radius: 8px; padding: 8px 10px; }
      .cov .stat b { font-size: 20px; display: block; }
      .cov .stat span { font-size: 12px; color: var(--c-muted); }
      @media (max-width: 760px) {
        .cov { grid-template-columns: 1fr; height: auto; }
        .covmap { height: 62vh; order: -1; }
        .cov aside { border-right: 0; padding: 16px; }
      }
    </style>
  </head>
  <body>
    <CoverageMap client:only="preact" />
  </body>
</html>
