// The state's own response teams, which back up local fire departments: the HAZMAT
// team, Vermont Task Force 1 (urban search and rescue) and fire investigation.
// Sources: the Division of Fire Safety's pages and its 2025 Fire Marshal Report,
// read 2026-11-13 (notes in ~/Desktop/FDVT/sites/dfs/NOTES.md).
import Archive from "../layouts/Archive.astro";

const DFS = "https://firesafety.vermont.gov";
const REPORT = `${DFS}/sites/firesafety/files/2025%20Fire%20Marshal%20Report/2025%20FM%20Report%202.0.pdf`;

const hazmatCalls: [string, number][] = [
  ["Vehicle or boat spills", 60],
  ["Chemical spills", 49],
  ["Above- or underground tank spills", 29],
  ["Other assistance", 27],
  ["Propane and natural gas", 18],
  ["Special event support", 9],
  ["White powder, suspicious package or unknown substance", 7],
  ["Radiological", 3],
  ["Drone-only missions", 3],
  ["Clandestine labs", 2],
  ["Lithium-ion battery or energy storage", 1],
];
const hazmatTotal = hazmatCalls.reduce((a, [, n]) => a + n, 0);
const max = hazmatCalls[0][1];

const incidents: [string, number][] = [
  ["Rescue and EMS", 29611],
  ["False alarms", 5703],
  ["Good intent", 4128],
  ["Service calls", 3154],
  ["Hazardous conditions", 2054],
  ["Fires", 1396],
  ["Everything else", 301],
];
const fmt = (n: number) => n.toLocaleString("en-US");

// Backcountry and technical rescue teams, from each team's own page or its
// host's, read 2026-11-13. Roughly north to south.
const rescueTeams = [
  {
    name: "Stowe Mountain Rescue",
    where: "Stowe · run by the town",
    text: "Cliff, ice-climbing, backcountry, swiftwater and wilderness search; 45 to 55 calls a year. More below.",
    url: "https://www.stowevt.gov/Departments/Mountain-Rescue",
  },
  {
    name: "Colchester Technical Rescue",
    where: "Colchester · run by the town",
    text: "One of the state's high-angle rope rescue teams, alongside Stowe's, with dive and boat crews for floods.",
    url: "https://www.sevendaysvt.com/arts-culture/backcountry-911-2138536",
  },
  {
    name: "Camels Hump Backcountry Rescue",
    where: "Richmond · part of Richmond Rescue",
    text: "About 30 volunteers, most of them EMTs or paramedics: ground search, medical care, ropes and extrication in northern Vermont.",
    url: "https://www.newsar.org/rtcl_listing/camels-hump-backcountry-rescue-chbr/",
  },
  {
    name: "Waterbury Backcountry Rescue",
    where: "Waterbury · part of Waterbury Ambulance Service",
    text: "Founded in 2002. Rescuers and EMTs who find, free and treat people hurt or lost where an ambulance can't reach, and bring them out to one.",
    url: "https://waterburyambulance.org/backcountry.html",
  },
  {
    name: "Huntington Backcountry Search and Rescue",
    where: "Huntington · part of the volunteer fire department",
    text: "The volunteer fire department answers Huntington's backcountry search and rescue calls as well as its fires and medical calls; the search and rescue team trains once or twice a month.",
    url: "https://www.huntingtonvt.org/?p=205",
  },
  {
    name: "Upper Valley Wilderness Response Team",
    where: "Upper Valley · volunteer nonprofit, Vermont and New Hampshire",
    text: "Founded in 1995 at Dartmouth's medical school. Searches for missing people in wilderness areas at the request of the Vermont State Police and New Hampshire Fish and Game; it also has a drone team.",
    url: "https://www.uvwrt.org/about",
  },
  {
    name: "Okemo Valley Technical Rescue",
    where: "Ludlow area · new volunteer nonprofit",
    text: "Formed by the Ludlow, Mount Holly and Proctorsville fire departments and Ludlow Ambulance after the 2023 floods, starting with swiftwater rescue and tactical casualty care.",
    url: "https://vermontjournal.com/news/okemo-valley-technical-rescue",
  },
  {
    name: "Rescue Inc. Technical Rescue Team",
    where: "Brattleboro · regional ambulance service",
    text: "On standby around the clock for flood, swiftwater and ice rescue, rope rescue, backcountry and wilderness rescue, confined spaces and drone work across southern Vermont.",
    url: "https://www.rescueinc.org",
  },
  {
    name: "New England K-9 Search and Rescue",
    where: "Statewide · volunteer dog teams, Vermont and New Hampshire",
    text: "Air-scent dogs and their handlers, called by the Vermont State Police and New Hampshire Fish and Game to search the woods for lost and missing people.",
    url: "https://northernwoodlands.org/articles/article/new-england-k-9-search-and-rescue",
  },
];
---

<Archive title="Vermont's Statewide Fire Teams: HAZMAT, Search and Rescue, Fire Investigation"
  description="The teams that back up Vermont's local fire departments: the state HAZMAT Response Team, Vermont Task Force 1 for urban search and rescue, the Fire and Explosion Investigation Unit, and Vermont's backcountry and technical rescue teams, from Stowe Mountain Rescue to Rescue Inc.">
  <main class="wrap page st">
    <p class="kicker">Statewide</p>
    <h1>The teams behind the local fire department</h1>
    <p class="lede">Vermont's fire service is local: towns and fire districts run their own departments.
      When an incident is bigger or more specialised than one department can handle, the state
      Division of Fire Safety sends its own teams. A local incident commander, usually the fire
      chief, asks for them.</p>

    <p class="e911"><strong>Emergency? Call 911.</strong> The HAZMAT and task force numbers below are for
      fire departments and incident commanders requesting help, not for the public.</p>

    <nav class="toc" aria-label="On this page">
      <a href="#hazmat">HAZMAT team</a>
      <a href="#usar">Search and rescue</a>
      <a href="#feiu">Fire investigation</a>
      <a href="#backcountry">Backcountry rescue teams</a>
      <a href="#numbers">2025 in numbers</a>
    </nav>

    <section id="hazmat">
      <h2>Hazardous Materials Response Team</h2>
      <p>The state HAZMAT team was created in 1994 to help every fire department in Vermont manage
        hazardous materials incidents, under <a href="https://legislature.vermont.gov/statutes/section/20/001/00033" target="_blank" rel="noopener">20 V.S.A. § 33</a>.
        It is Vermont's only FEMA Type I hazardous materials team, equipped for chemical, biological,
        radiological and other hazardous materials emergencies anywhere in the state.</p>
      <ul class="facts">
        <li><b>35</b> hazardous materials technicians, led by a chief, a deputy chief, three captains and two lieutenants</li>
        <li><b>4</b> regional response vehicles</li>
        <li><b>18</b> HAZMAT trailers kept at local fire departments around the state, for operations-level response and decontamination</li>
        <li><b>1,098</b> responders given refresher training in 2025</li>
      </ul>
      <h3>{hazmatTotal} responses in 2025</h3>
      <div class="bars" role="table" aria-label="HAZMAT team responses in 2025, by type">
        {hazmatCalls.map(([k, n]) => (
          <div class="bar" role="row">
            <span class="bk" role="cell">{k}</span>
            <span class="bt" role="cell"><i style={`width:${(100 * n) / max}%`}></i><b>{n}</b></span>
          </div>
        ))}
      </div>
      <p>Among them: two ammonia releases at an industrial site in Brattleboro, about 100 gallons of
        mixed sulfuric and nitric acid leaking from a chemical room in Middlebury, a box truck that
        left Interstate 91 in Hartland and fell about 60 feet into the river below, and two days of
        drone reconnaissance and thermal imaging over a wildfire in Fair Haven.</p>
      <p>Departments can recover the costs of responding to a hazardous materials incident; the
        Division has a <a href={`${DFS}/emergency/hazmat`} target="_blank" rel="noopener">cost recovery information sheet</a>.</p>
      <p class="call">To request the team: the HAZMAT hotline, <a href="tel:+18006415005">800-641-5005</a>.</p>
    </section>

    <section id="usar">
      <h2>Vermont Task Force 1: urban search and rescue</h2>
      <p>Vermont Task Force One (VT-TF1) rescues people trapped in collapsed or damaged buildings, and
        brings a large water rescue team with boats for moving water and rescue swimmers. Its 90
        members are trained in rope, confined space, trench, building collapse and swiftwater rescue,
        with specialists in search, medical, HAZMAT, logistics and planning, structural engineers,
        search dogs and drones.</p>
      <ul class="facts">
        <li><b>90</b> members</li>
        <li><b>18</b> calls in 2025, from building collapses to floods</li>
        <li>Activated for several days during the <b>March and July 2025</b> floods in central Vermont and the Northeast Kingdom</li>
        <li><b>14 days</b> in Kentucky in April 2025, after flooding and tornadoes there, under the interstate mutual aid compact</li>
      </ul>
      <p class="call">To request the task force or the Division's other special operations teams after
        hours: Vermont Emergency Management's watch officer, <a href="tel:+18003470488">1-800-347-0488</a>.</p>
    </section>

    <section id="feiu">
      <h2>Fire and Explosion Investigation Unit</h2>
      <p>State investigators from the Department of Public Safety look into serious fires and explosions
        and work out their cause. In 2025 they were directly involved in
        <b>159</b> fire investigations.</p>
      <div class="causes" aria-label="Causes of fires investigated in 2025">
        <div><b>59</b><span>accidental</span></div>
        <div><b>22</b><span>set deliberately</span></div>
        <div><b>76</b><span>undetermined</span></div>
        <div><b>2</b><span>other causes</span></div>
      </div>
      <p>Most were in homes: 79 single-family houses (9 of them mobile homes), 15 multi-unit buildings
        and 3 duplexes, along with barns, vehicles, garages, businesses and campers. The Division notes
        that Vermont's fire deaths happen mostly in single-family homes in winter, and that investigators
        keep finding missing smoke alarms, or alarms with the battery taken out.</p>
      <p class="call">To report information about a fire set deliberately, without giving your name:
        <a href="tel:+18003227766">1-800-32-ARSON</a> (1-800-322-7766).</p>
    </section>

    <section id="backcountry">
      <h2>Backcountry and technical rescue</h2>
      <p>Searches for lost people anywhere in Vermont are managed by the Vermont State Police's Search and
        Rescue Team. Carrying an injured hiker off a mountain, lowering a climber off a cliff or pulling someone
        out of a flooded river takes specialist teams. Vermont relies on
        <a href="https://www.sevendaysvt.com/arts-culture/outdoorsrecreation/vermont-backcountry-volunteers-answer-the-call-for-rescue/" target="_blank" rel="noopener">a dozen or so local ones</a>,
        most of them volunteers, many run by a town's fire department or ambulance service.</p>

      <div class="teams">
        {rescueTeams.map((t) => (
          <article class="team">
            <h3><a href={t.url} target="_blank" rel="noopener">{t.name}</a></h3>
            <p class="where">{t.where}</p>
            <p>{t.text}</p>
          </article>
        ))}
      </div>

      <h3>Stowe Mountain Rescue, in more detail</h3>
      <ul class="facts">
        <li>Founded in <b>1980</b> for climbers and ice climbers in the Smugglers' Notch cliffs; it now also does
          backcountry rescue, flood and swiftwater rescue and wilderness searches</li>
        <li><b>45 to 55</b> calls a year, in every season</li>
        <li>Free to the people it rescues; funded mainly by the Town of Stowe, with state and federal grants for equipment</li>
        <li>An accredited member of the Mountain Rescue Association and a licensed first responder service</li>
        <li>Under an agreement with the state Department of Public Safety, it can be sent to other parts of Vermont</li>
      </ul>
      <p>Inside Stowe's ski area, injuries are Mt. Mansfield Ski Patrol's; outside the boundary they are
        Mountain Rescue's. The team carries people out of the backcountry and hands them to Stowe's ambulance
        service. New members can apply each November and December, followed by a nine-month probation.</p>
      <p class="small">Know a team that's missing? <a href="/contact">Tell us</a>.</p>
    </section>

    <section id="numbers">
      <h2>Vermont's fire departments in 2025</h2>
      <p>Departments reported <b>{fmt(46347)}</b> incidents in their own towns in 2025, plus
        {fmt(3628)} calls helping neighbouring departments. Almost two-thirds were medical calls and
        rescues; fires were 3%.</p>
      <div class="bars" role="table" aria-label="Incidents reported by Vermont fire departments in 2025, by type">
        {incidents.map(([k, n]) => (
          <div class="bar" role="row">
            <span class="bk" role="cell">{k}</span>
            <span class="bt" role="cell"><i style={`width:${(100 * n) / incidents[0][1]}%`}></i><b>{fmt(n)}</b></span>
          </div>
        ))}
      </div>
      <p class="small">From the report's table by incident type. Its introduction gives a different
        total, 51,347; the figures here are the table's. Departments filed these through the national
        reporting system (NFIRS), which closed in early 2026; they now report to its replacement,
        NERIS.</p>
    </section>

    <p class="src">Sources: Vermont Division of Fire Safety,
      <a href={REPORT} target="_blank" rel="noopener">2025 Fire Marshal Report</a>;
      <a href={`${DFS}/emergency/hazmat`} target="_blank" rel="noopener">HAZMAT Response Team</a>;
      <a href={`${DFS}/emergency/usar`} target="_blank" rel="noopener">Urban Search and Rescue</a>;
      Town of Stowe, <a href="https://www.stowevt.gov/Departments/Mountain-Rescue" target="_blank" rel="noopener">Mountain Rescue</a>.
      Read November 2026.</p>
    <p><a href="/departments">← All departments</a></p>
  </main>
</Archive>

