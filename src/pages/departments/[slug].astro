---
import Archive from "../../layouts/Archive.astro";
import {
  apart,
  BURN_RULE,
  countyMap,
  memberCount,
  towns,
  type Apart,
  type Town,
} from "../../lib/towns";
import type { Station } from "../../lib/stations";

export function getStaticPaths() {
  return [
    ...towns.map((town) => ({ params: { slug: town.slug }, props: { town } })),
    ...apart.map((a) => ({ params: { slug: a.slug }, props: { standalone: a } })),
  ];
}

// Two kinds of page share this template: a town, with the departments and
// stations filed under it, and a department that is not its town's own — the
// Air National Guard's, at the airport — which has a page to itself. The
// difference is what each can claim. A department's page claims no ground: it
// states no area, draws no town as its own, and leaves burning to the town.
const props = Astro.props as { town: Town } | { standalone: Apart };
const town = "town" in props ? props.town : null;
const standalone = "standalone" in props ? props.standalone : null;
const subject = (town ?? standalone)!;
const place = town ? town.name : standalone!.town;
const county = subject.county;
const stations = subject.stations;
const departments = town ? town.departments : [standalone!.department];
// The town a standalone department works from, when the town has a page.
const home = standalone ? (towns.find((t) => t.name === standalone.town) ?? null) : null;

const dept = departments[0] ?? null;
const members = memberCount({ departments });

// Each station's own record, rendered inline. 139 of 196 towns have exactly one
// station, so a separate page per building said the same thing twice; the
// station keeps its slug as an anchor here so old links still land on it.
const stationRecord = (s: Station): [string, string][] =>
  (
    [
      ["Street address", s.address],
      ["Town", s.town],
      ["County", s.county ? `${s.county} County` : ""],
      ["ZIP", String(s.zip || "")],
      ["Coordinates", `${s.lat.toFixed(5)}, ${s.lng.toFixed(5)}`],
      // A station added from a photograph has no E911 record, and String(null)
      // is "null" — truthy — so it has to be emptied before the filter.
      ["E911 site ID", s.esiteid != null ? String(s.esiteid) : ""],
      ["E911 first mapped", s.mapped],
      ["E911 last updated", s.updated],
    ] as [string, string][]
  ).filter(([, v]) => v);

// The town drawn inside its county, with every station in the county plotted.
// A lone outline says nothing; the neighbours are the point, because that is
// who turns out on a mutual aid call.
const map = countyMap(
  town
    ? { county, boundary: town.boundary, town: town.name, label: town.name, stations }
    : { county, boundary: null, town: null, label: null, stations },
);
const others = map ? map.points.filter((p) => !p.mine).length : 0;
// Stations inside this town's line that belong to a department with a page of
// its own. They are drawn as someone else's, and counting them as a
// neighbouring town's would be wrong in the other direction.
const apartHere = town ? town.apart.flatMap((a) => a.stations).length : 0;
const neighbourStations = others - apartHere;
const apartNames = town ? town.apart.map((a) => `the ${a.department.name}`).join(" and ") : "";

const num = (n: number) => n.toLocaleString("en-US");

// Area, in the terms this page means it. A Vermont town line does not stop at
// the shoreline, so what VCGI files as the town's area is land and water
// together — half again the land in Burlington, three times it in North Hero.
// What this page asks is how much ground a department covers, so the land
// leads. Neither number is quietly swapped for the other: every row says which
// of the two it is, because an unlabelled "Area" is how the overstatement sat
// here unnoticed. A standalone department states none: the town's ground is
// not what it covers.
const area = town?.boundary ?? null;
const acreage = (acres: number, sqmi: number) => `${num(acres)} acres · ${sqmi} sq mi`;
const areaSplit =
  area && area.landAcres != null && area.landSqmi != null && area.waterSqmi != null
    ? {
        land: acreage(area.landAcres, area.landSqmi),
        total: acreage(area.totalAcres, area.totalSqmi),
        waterSqmi: area.waterSqmi,
        totalSqmi: area.totalSqmi,
        // The total earns a row of its own wherever the water is a twentieth of
        // the town or more — 28 of the 189 towns on the roster, and the ones
        // where anyone who knows the place would read the land figure as wrong.
        // Below that the two numbers say the same thing and the second row is
        // noise: Barre Town is 30.53 sq mi of land inside 30.73.
        showTotal: area.waterSqmi / (area.landSqmi + area.waterSqmi) >= 0.05,
      }
    : null;

// Only facts we hold. A row we cannot fill is left out rather than shown empty,
// which would read as a claim that the answer is nothing.
const facts: [string, string][] = [
  ["Stations", String(stations.length)],
  ["Photographed", `${subject.photographed} of ${stations.length}`],
  // No land figure means the Census carries no row under a name that matches,
  // so the total is all there is — said as the total, not as "Area".
  areaSplit
    ? ["Land area", areaSplit.land]
    : area
      ? ["Area, water included", acreage(area.totalAcres, area.totalSqmi)]
      : null,
  areaSplit?.showTotal ? ["Inside the town line", areaSplit.total] : null,
  members != null ? ["Firefighters", String(members)] : null,
  dept?.budget ? ["Budget, FY2026", `$${num(dept.budget)}`] : null,
  dept?.type ? ["Department type", dept.type] : null,
  dept?.fdid ? ["FDID", dept.fdid] : null,
  dept?.founded ? ["Founded", String(dept.founded)] : null,
].filter(Boolean) as [string, string][];

// What is written up, and what is still blank. Drives both the page body and
// the honest note at the bottom about what is missing.
const written = (
  [
    ["History", dept?.history],
    ["Joining", dept?.joining],
    ["Burn permits", dept?.burnPermits],
    ["Call volume", dept?.callsNote],
    ["Budget", dept?.budgetNote],
  ] as [string, string | null | undefined][]
)
  // Burning is the town's business, and the town's own page carries it.
  .filter(([k]) => town || k !== "Burn permits");
const missing = written.filter(([, v]) => !v).map(([k]) => k);

const plural = (n: number, one: string) => `${n} ${one}${n === 1 ? "" : "s"}`;
const title = town
  ? `${town.name} — fire stations, department and coverage – Vermont Fire Stations`
  : `${dept!.name}, ${place} – Vermont Fire Stations`;
const description = standalone
  ? `${dept!.name}, working from ${place}, Vermont: ${plural(stations.length, "station")}, with contact and what is on record about its calls.`
  : dept
    ? `${dept.name}: contact, coverage, joining, burn permits and history, with ${plural(stations.length, "station")} in ${place}, Vermont.`
    : `Fire stations in ${place}, Vermont — ${stations.length} on record, with the town's boundary and area.`;
---

<Archive title={title} description={description}>
  <main class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/stations">All stations</a>
      <span aria-hidden="true">/</span>
      {home ? <a href={`/departments/${home.slug}`}>{place}</a> : <span>{place}</span>}
    </nav>

    <header class="head">
      {/* The department is what the page is about; the town is where it is. With
          more than one department, or none on record, the town has to lead —
          there is no single name to put at the top. */}
      {departments.length === 1 ? (
        <>
          <p class="stamp">{place}{county && `, ${county} County`}</p>
          <h1>{departments[0].name}</h1>
        </>
      ) : (
        <>
          <p class="stamp">{county && `${county} County`}</p>
          <h1>{place}</h1>
          {departments.length > 1 && (
            <p class="sub">{departments.map((d) => d.name).join(" · ")}</p>
          )}
        </>
      )}
      {/* Each kind of page points at the other, because a reader who came for
          one is as likely to have wanted the other. */}
      {standalone && home && (
        <p class="also">
          Works from {place}, apart from{" "}
          <a href={`/departments/${home.slug}`}>{place}'s own fire department</a>.
        </p>
      )}
      {town && town.apart.length > 0 && (
        <p class="also">
          Also in {place}, on a page of its own:{" "}
          {town.apart.map((a, i) => (
            <>{i > 0 && " · "}<a href={`/departments/${a.slug}`}>{a.department.name}</a></>
          ))}.
        </p>
      )}
    </header>

    <div class="facts">
      <dl>
        {facts.map(([k, v]) => (
          <div class="row"><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
      {areaSplit?.showTotal && (
        <p class="fine">
          {place}'s line runs out into the water, and {areaSplit.waterSqmi} of the
          {" "}{areaSplit.totalSqmi} square miles inside it are water. The land figure is the
          Census count; the total is the boundary VCGI draws.
        </p>
      )}
    </div>


    <section class="block" aria-labelledby="st-h">
      <h2 id="st-h">
        {stations.length === 1 ? "The station" : `The ${stations.length} stations`}
      </h2>

      {stations.length > 1 && (
        <ul class="jump">
          {stations.map((s) => (
            <li>
              <a href={`#${s.slug}`}>
                <span class="dot" data-has={s.photo ? "yes" : "no"} aria-hidden="true"></span>
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      )}

      {stations.map((s) => (
        <article class="station" id={s.slug}>
          {stations.length > 1 && <h3>{s.name}</h3>}
          <p class="staddr">{s.address}</p>

          {s.photo ? (
            <figure class="shot">
              <img src={s.photo.src}
                   alt={`${s.name} at ${s.address}, ${s.town}, Vermont`}
                   width={s.photo.width ?? undefined} height={s.photo.height ?? undefined}
                   loading="lazy" />
              <figcaption>
                {s.photo.caption && s.photo.caption !== s.name && (
                  <span class="cap">{s.photo.caption}</span>
                )}
                <span class="credit">
                  {s.photo.photographer ? `Photograph by ${s.photo.photographer}` : "Photograph"}
                  {s.photo.dateTaken && `, ${s.photo.dateTaken}`}
                </span>
              </figcaption>
            </figure>
          ) : (
            <div class="nophoto">
              <p><strong>No photograph yet.</strong></p>
              <p>
                If you have a picture of this station, <a href="/contact">send it in</a> — it
                will be credited to you.
              </p>
            </div>
          )}

          <dl class="rec">
            {stationRecord(s).map(([k, v]) => (
              <div class="row"><dt>{k}</dt><dd>{v}</dd></div>
            ))}
          </dl>
          <p class="prov">
            {s.esiteid != null ? (
              <>
                Location from the <a href="https://geodata.vermont.gov/" target="_blank"
                rel="noopener">Vermont E911 site file (VCGI)</a>.{" "}
              </>
            ) : (
              <>
                This station is <strong>not</strong> in the{" "}
                <a href="https://geodata.vermont.gov/" target="_blank" rel="noopener">Vermont
                E911 site file</a>; it was added from a photograph taken at the building.{" "}
              </>
            )}
            Spotted something wrong? <a href="/contact">Send a correction</a>.
          </p>
        </article>
      ))}
    </section>

    {map && (
      <figure class="cmap">
        <svg viewBox={`0 0 ${map.width} ${map.height}`} role="img"
             aria-label={town
               ? `${place} within ${map.county} County, with every fire station in the county marked`
               : `${dept!.name}'s ${stations.length === 1 ? "station" : "stations"} in ${place}, with every fire station in ${map.county} County marked`}>
          {/* Neighbours first, so the subject town draws over their shared edges.
              The id is the shape's own index either way, so the clip below can
              name every town without caring which order they were drawn in. */}
          {map.shapes.map((s, i) => !s.isSubject && (
            <path id={`t${i}`} d={s.d} class={s.onRoster ? "nb" : "nb none"} />
          ))}
          {map.shapes.map((s, i) => s.isSubject && (
            <path id={`t${i}`} d={s.d} class="me" />
          ))}

          {/* The lake over the towns: a town boundary runs out into Lake
              Champlain, so this is what puts the shoreline back. Clipped to the
              county, because the far side of the lake is New York and drawing
              it would say this map covers more than it does. The clip reuses
              the town paths rather than repeating them — they are the single
              largest thing on the page. */}
          {map.water && (
            <>
              <clipPath id="county">
                {map.shapes.map((_, i) => <use href={`#t${i}`} />)}
              </clipPath>
              <path d={map.water} class="water" fill-rule="evenodd" clip-path="url(#county)" />
            </>
          )}
          {map.waterLabels.map((w) => (
            <text x={w.cx} y={w.cy} class="wl" text-anchor="middle"
                  transform={w.vertical ? `rotate(-90 ${w.cx.toFixed(1)} ${w.cy.toFixed(1)})` : undefined}
            >{w.name}</text>
          ))}

          {map.shapes.filter((s) => !s.isSubject && s.labelled).map((s) => (
            <text x={s.lx} y={s.ly} class="nbl" text-anchor="middle">{s.name}</text>
          ))}

          {map.points.filter((p) => !p.mine).map((p) => (
            <circle cx={p.x} cy={p.y} r="3" class="pt"><title>{p.label}</title></circle>
          ))}
          {map.points.filter((p) => p.mine).map((p) => (
            <circle cx={p.x} cy={p.y} r="5.5" class={p.photo ? "pt mine lit" : "pt mine"}>
              <title>{p.label}</title>
            </circle>
          ))}

          {map.label && (
            <text x={map.label.x} y={map.label.y} class="mel" text-anchor="middle">{map.label.text}</text>
          )}

          <g class="bar" transform={`translate(${map.width - map.scale.px - 16}, ${map.height - 18})`}>
            <line x1="0" y1="0" x2={map.scale.px} y2="0" />
            <line x1="0" y1="-4" x2="0" y2="4" />
            <line x1={map.scale.px} y1="-4" x2={map.scale.px} y2="4" />
            <text x={map.scale.px / 2} y="-7" text-anchor="middle">{map.scale.miles} miles</text>
          </g>
        </svg>
        {town ? (
          <figcaption>
            {place} in {map.county} County. Every fire station in the county is marked —
            {" "}{stations.length} here, {neighbourStations} in neighbouring towns, which is
            who turns out on a mutual aid call.
            {apartHere > 0 && (
              ` The ${apartHere === 1 ? "one other station" : `${apartHere} other stations`} inside
              the town line ${apartHere === 1 ? "belongs" : "belong"} to ${apartNames}.`
            )}
            {" "}Boundaries and water from VCGI; fire district lines are not town lines, and
            village districts and contracted coverage cross them. A town line runs out into
            the lake, so the shoreline here is the water drawn over the boundary, not the
            boundary itself.
          </figcaption>
        ) : (
          <figcaption>
            The {dept!.name}'s {stations.length === 1 ? "station" : `${stations.length} stations`},
            in {place}, with every other fire station in {map.county} County marked
            — {others} of them. No town is drawn as its own, because the ground it covers is
            not a town's. Boundaries and water from VCGI; a town line runs out into the lake,
            so the shoreline here is the water drawn over the boundary, not the boundary itself.
          </figcaption>
        )}
      </figure>
    )}

    {dept && (dept.chief || dept.phone || dept.email || dept.website) && (
      <section class="block" aria-labelledby="c-h">
        <h2 id="c-h">Contact</h2>
        <dl>
          {dept.chief && <div class="row"><dt>Chief</dt><dd>{dept.chief}</dd></div>}
          {dept.phone && (
            <div class="row"><dt>Telephone</dt>
              <dd><a href={`tel:${dept.phone.replace(/[^0-9+]/g, "")}`}>{dept.phone}</a></dd></div>
          )}
          {dept.email && (
            <div class="row"><dt>Email</dt>
              <dd><a href={`mailto:${dept.email}`}>{dept.email}</a></dd></div>
          )}
          {dept.website && (
            <div class="row"><dt>Website</dt>
              <dd><a href={dept.website} target="_blank" rel="noopener">{dept.website.replace(/^https?:\/\//, "")}</a></dd></div>
          )}
        </dl>
        <p class="fine">
          In an emergency dial 911. These are business lines.
        </p>
      </section>
    )}

    {dept?.history && (
      <section class="block" aria-labelledby="h-h">
        <h2 id="h-h">History</h2>
        {dept.history.split("\n\n").map((p) => <p>{p}</p>)}
      </section>
    )}

    {dept?.callsNote && (
      <section class="block" aria-labelledby="ca-h">
        <h2 id="ca-h">Calls</h2>
        {dept.callsNote.split("\n\n").map((p) => <p>{p}</p>)}
      </section>
    )}

    {(dept?.budgetNote || dept?.budgetLines?.length) && (
      <section class="block" aria-labelledby="b-h">
        <h2 id="b-h">Money</h2>
        {dept.budgetNote?.split("\n\n").map((p) => <p>{p}</p>)}
        {dept.budgetLines?.length > 0 && (
          <>
            <table class="lines">
              <caption>Largest lines, fiscal year 2026</caption>
              <tbody>
                {dept.budgetLines.map((l) => (
                  <tr>
                    <th scope="row">{l.label}</th>
                    <td>
                      ${num(l.amount)}
                      <span class="bar" style={`--w:${Math.round((l.amount / dept.budgetLines[0].amount) * 100)}%`} aria-hidden="true"></span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {dept.budget && (
              <p class="fine">
                The {dept.budgetLines.length} largest lines, against a department total of
                {" "}${num(dept.budget)}.
              </p>
            )}
          </>
        )}
      </section>
    )}

    {town && (
      <section class="block" aria-labelledby="bp-h">
        <h2 id="bp-h">Burning</h2>
        {dept?.burnPermits
          ? dept.burnPermits.split("\n\n").map((p) => <p>{p}</p>)
          : <p>{BURN_RULE}</p>}
      </section>
    )}

    {dept?.joining && (
      <section class="block join" aria-labelledby="j-h">
        <h2 id="j-h">Joining</h2>
        {dept.joining.split("\n\n").map((p) => <p>{p}</p>)}
        {dept.joinUrl && (
          <p><a class="btn" href={dept.joinUrl} target="_blank" rel="noopener">Apply to {dept.name} →</a></p>
        )}
      </section>
    )}

    {missing.length > 0 && (
      <section class="block gap" aria-labelledby="g-h">
        <h2 id="g-h">Not recorded yet</h2>
        <p>
          Nothing is written up here for <strong>{missing.join(", ").toLowerCase()}</strong>.
          Not because it does not exist — because nobody has typed it in. If you know this
          department, <a href="/contact">tell us</a> and it goes on the record with its
          source named.
        </p>
      </section>
    )}

    <p class="back"><a href="/#map">← Back to the map</a></p>
  </main>
</Archive>

<style>
  .page { padding: 2.4rem 0 3.4rem; max-width: 46rem; }
  .crumbs {
    font-size: 0.72rem; letter-spacing: 0.11em; text-transform: uppercase;
    color: var(--ink-3); display: flex; gap: 0.5rem; margin-bottom: 1.4rem;
  }
  .crumbs a { color: var(--ink-2); text-decoration: none; border-bottom: 1px solid transparent; }
  .crumbs a:hover { color: var(--ink); border-color: var(--red); }
  .head { margin-bottom: 1.8rem; }
  .stamp {
    font-size: 0.72rem; letter-spacing: 0.11em; text-transform: uppercase;
    color: var(--ink-3); margin: 0 0 0.3rem;
  }
  h1 {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1.1; margin: 0 0 0.35rem;
  }
  .sub { margin: 0; color: var(--ink-2); font-size: 0.95rem; }
  .also { margin: 0.7rem 0 0; color: var(--ink-2); font-size: 0.9rem; max-width: 58ch; }
  .also a { color: var(--red); }

  .facts { margin-bottom: 2rem; }

  .cmap { margin: 0 0 2.4rem; }
  .cmap svg { width: 100%; height: auto; display: block; background: var(--surface); }
  /* Neighbouring towns: outlined, not filled, so the subject reads first.
     A town with no station on the roster is left hollow — the gap is data. */
  .nb { fill: color-mix(in srgb, var(--ink-3) 8%, transparent); stroke: var(--ink-3); stroke-width: 0.6; }
  /* A town with no station on the roster keeps the same fill and says so with a
     dashed edge. Leaving it unfilled read as a hole in the county rather than
     as a gap in the record — badly so in dark mode, where no fill is darker
     than its neighbours. */
  .nb.none { stroke-dasharray: 3 2.5; }
  .me { fill: color-mix(in srgb, var(--red) 14%, transparent); stroke: var(--red); stroke-width: 1.8; }
  /* The fill has to be opaque — it is covering the part of each town boundary
     that lies in the lake, the subject town's red outline included. */
  /* Water needs its own tone. Filled with --surface it differed from land by
     seven levels out of 255 in dark mode — the lake was drawn, clipped and
     labelled, and still invisible, so Burlington looked like it had land
     between it and the shore.
     Giving it a tone tripled that to 21 levels, and it is now a lighter slate
     again: against the land the fill went from 1.17:1 to 1.26:1 and, more to
     the point, from 9.2 to 20.7 in CIELAB, because what separates water from
     land here is colour and not lightness. 3:1 on the fills is not reachable
     at all by going darker — dark mode would need negative luminance — and
     reaching it by going lighter takes an L* around 43, at which the lake is
     the brightest thing on a page about fire stations.
     The stroke is a whole pixel wide because at 0.7 it fell under one pixel on
     a scaled-down map and averaged away, and the shoreline is the cue that
     survives scaling. Lightening the fill would have cost that stroke its
     contrast — --ink-3 on this water is 2.64:1, against 3.87 on the tone it
     replaced — so the shoreline and the lake's own label take --ink-2, which
     reads 4.57:1 on it and beats what either managed before. */
  .water { fill: var(--water); stroke: var(--ink-2); stroke-width: 1; }
  /* Named on the water, so it takes --ink-2 rather than the --ink-3 every other
     label on the map uses: on the water tone --ink-3 is 2.6:1 and this is
     4.6:1. The one label not drawn on the land is the one that needs its own
     colour. */
  .wl {
    font-size: 8.5px; fill: var(--ink-2); letter-spacing: 0.14em;
    text-transform: uppercase; font-style: italic;
  }
  .nbl { font-size: 8px; fill: var(--ink-3); letter-spacing: 0.02em; }
  .mel {
    font-family: "Source Serif 4", Georgia, serif; font-size: 15px;
    fill: var(--ink); font-weight: 600;
  }
  .pt { fill: var(--ink-3); stroke: var(--surface); stroke-width: 1; }
  .pt.mine { fill: var(--ink); stroke-width: 1.5; }
  .pt.mine.lit { fill: var(--red); }
  .bar line { stroke: var(--ink-3); stroke-width: 1; }
  .bar text { font-size: 9px; fill: var(--ink-3); }
  .cmap figcaption { margin-top: 0.6rem; font-size: 0.78rem; color: var(--ink-3); line-height: 1.5; }

  .shot { margin: 0 0 2.4rem; }
  .shot img { display: block; width: 100%; height: auto; border: 1px solid var(--line); box-shadow: var(--shadow); }
  .shot figcaption { margin-top: 0.6rem; font-size: 0.82rem; color: var(--ink-2); }
  .cap { display: block; }
  .credit { display: block; color: var(--ink-3); }

  .block { margin-bottom: 2.2rem; }
