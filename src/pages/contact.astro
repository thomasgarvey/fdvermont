---
import Archive from "../layouts/Archive.astro";

// The public-facing address. It's a Namecheap forwarding alias on
// fdvermont.org, not a personal inbox, so it can be changed or retired
// without touching anything else on the site — change it here and the
// three links below follow.
const EMAIL = "hello@fdvermont.org";

const mail = (subject: string, body: string) =>
  `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const ways = [
  {
    id: "photo",
    title: "Submit a photo",
    blurb:
      "Shot a station that's still a slate marker on the map? Attach the photo and I'll add it, credited to you.",
    action: "Email a photo",
    href: mail("Station photo for FD Vermont", [
      "Department:",
      "Town:",
      "Roughly when you took it:",
      "How you'd like to be credited:",
      "",
      "(attach the photo to this email)",
    ].join("\n")),
  },
  {
    id: "correction",
    title: "Correct a record",
    blurb:
      "Wrong address, a station that's closed, a department renamed or merged? Corrections get fixed at the source and flow back into the map.",
    action: "Send a correction",
    href: mail("Correction for FD Vermont", [
      "Department or station:",
      "What's wrong:",
      "What it should be:",
      "Source, if you have one:",
    ].join("\n")),
  },
  {
    id: "general",
    title: "Anything else",
    blurb:
      "Questions about the project, a station worth photographing, or an idea for the site.",
    action: "Get in touch",
    href: mail("FD Vermont", ""),
  },
];
---

<Archive title="Contact – Vermont Fire Departments"
  description="Send a station photo, a correction, or a question to the Vermont Fire Departments archive.">
    <main class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Send a photo, or set the record straight.</h1>
      <p class="lede">
        Vermont Fire Departments is an independent archive of the state's firehouses — photos,
        locations, and department details, kept up to date by the people who know these
        stations best. Everything below goes to one inbox and gets read.
      </p>

      <div class="ways">
        {ways.map((w) => (
          <article class="way" id={w.id}>
            <h2>{w.title}</h2>
            <p>{w.blurb}</p>
            <a class="cta" href={w.href}>{w.action} →</a>
          </article>
        ))}
      </div>

      <p class="note">
        Every link opens your email app with a message started for you. If it doesn't,
        write to <a href={mail("FD Vermont", "")}>{EMAIL}</a> directly.
      </p>

      <section class="terms" aria-labelledby="terms-h">
        <h2 id="terms-h">Using your photographs</h2>
        <p>
          Photographs remain the copyright of the photographer. Sending one grants Vermont
          Fire Departments permission to publish it on this site with credit. Tell me you'd
          like it removed and it comes down.
        </p>
      </section>

      <p class="back"><a href="/">← Back to the map</a></p>
    </main>
</Archive>

<style>
  h2 {
    font-family: "Source Serif 4", Georgia, "Times New Roman", serif;
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }
  .eyebrow {
    font-family: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 0.7rem;
  }

  main {
    flex: 1;
    padding: 4.5rem 0 5rem;
  }
  h1 {
    margin: 0 0 1.1rem;
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.022em;
    max-width: 17ch;
    text-wrap: balance;
  }
  .lede {
    margin: 0 0 3rem;
    max-width: 58ch;
    font-size: 1.1rem;
    color: var(--ink-2);
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  .way {
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 3px;
    padding: 1.7rem 1.6rem 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow);
  }
  .way h2 {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: 1.24rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .way p {
    margin: 0 0 1.6rem;
    color: var(--ink-2);
    font-size: 0.98rem;
  }
  .cta {
    margin-top: auto;
    align-self: flex-start;
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--red);
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }
  .cta:hover {
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .ways {
      grid-template-columns: 1fr;
    }
  }

  .note {
    margin: 2.6rem 0 0;
    max-width: 58ch;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .terms {
    margin: 2.2rem 0 0;
    max-width: 58ch;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .terms h2 {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 1.05rem;
    margin: 0 0 0.45rem;
  }
  .terms p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .note a {
    color: var(--red);
  }
  .back {
    margin: 2.4rem 0 0;
    font-family: inherit;
    font-size: 0.8rem;
  }
  .back a {
    text-decoration: none;
    color: var(--ink-2);
  }
  .back a:hover {
    color: var(--ink);
  }

</style>
