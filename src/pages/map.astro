---
import LocationMap from "../components/islands/LocationMap.tsx";
import Analytics from "../components/Analytics.astro";
import Seo from "../components/Seo.astro";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Map of Vermont fire stations – Vermont Fire Stations</title>
    <meta name="description" content="A full-screen map of every fire station in Vermont, marked by whether the archive has a photograph of it yet." />
    <Seo title="Map of Vermont fire stations – Vermont Fire Stations" description="A full-screen map of every fire station in Vermont, marked by whether the archive has a photograph of it yet." />
    <Analytics />
  </head>
  <body style="margin:0">
    <LocationMap client:only="preact" height="100vh" />
  </body>
</html>
