---
// Forum pages share the archive chrome, plus a strip saying who is signed in.
import Archive from "../../layouts/Archive.astro";
import { forumConfigured } from "../../lib/forum";

interface Props {
  title: string;
}
const { title } = Astro.props;
const { user, member } = Astro.locals;
---

<Archive title={`${title} – Forum – Vermont Fire Departments`}>
  <meta name="robots" content="noindex" slot="head" />
  <main class="wrap forum">
    <div class="fbar">
      <a class="fhome" href="/forum">Firefighters' Forum</a>
      {user && (
        <span class="who">
          {member?.display_name ?? user.email}
          {member?.is_admin && member.status === "approved" && <a href="/forum/admin">Members</a>}
          <form method="post" action="/forum/logout">
            <button type="submit" class="linkbtn">Sign out</button>
          </form>
        </span>
      )}
    </div>
    {forumConfigured ? (
      <slot />
    ) : (
      <p class="notice">
        The forum isn't connected yet. Set <code>PUBLIC_SUPABASE_URL</code> and{" "}
        <code>PUBLIC_SUPABASE_ANON_KEY</code> — see <code>docs/forum.md</code>.
      </p>
    )}
  </main>
</Archive>

<style is:global>
  .forum { flex: 1; padding: 2.4rem 0 5rem; max-width: 820px; }
  .forum h1, .forum h2 { font-family: "Source Serif 4", Georgia, serif; }
  .forum h1 { font-size: clamp(1.7rem, 3.6vw, 2.4rem); line-height: 1.1; margin: 0 0 0.8rem; letter-spacing: -0.015em; }
  .forum h2 { font-size: 1.2rem; margin: 2.2rem 0 0.8rem; }
  .forum a { color: inherit; }
  .forum p.lede { color: var(--ink-2); max-width: 58ch; margin: 0 0 1.8rem; }
  .fbar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem 1rem;
    padding-bottom: 0.9rem; margin-bottom: 2rem; border-bottom: 1px solid var(--line);
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2);
  }
  .fbar a { text-decoration: none; }
  .fbar a:hover { color: var(--red); }
  .fhome { color: var(--ink) !important; }
  .who { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .who form { margin: 0; display: inline; }
  .linkbtn {
    background: none; border: 0; padding: 0; cursor: pointer; color: inherit;
    font: inherit; letter-spacing: inherit; text-transform: inherit;
  }
  .linkbtn:hover { color: var(--red); }

  .card {
    border: 1px solid var(--line); background: var(--surface); border-radius: 3px;
    padding: 1.4rem 1.5rem; box-shadow: var(--shadow);
  }
  .fform { display: grid; gap: 1rem; max-width: 560px; }
  .fform label { display: grid; gap: 0.3rem; font-size: 0.85rem; font-weight: 600; color: var(--ink-2); }
  .fform input, .fform textarea, .fform select {
    font: inherit; font-size: 1rem; color: var(--ink); background: var(--paper);
    border: 1px solid var(--line); border-radius: 3px; padding: 0.6rem 0.7rem; width: 100%;
    box-sizing: border-box;
  }
  .fform textarea { min-height: 9rem; resize: vertical; }
  .fform input:focus, .fform textarea:focus { outline: 2px solid var(--red); outline-offset: 1px; }
  .btn {
    justify-self: start; cursor: pointer; border: 0; border-radius: 3px; background: var(--red); color: #fff;
    font: inherit; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.75rem 1.2rem; min-height: 44px;
  }
  .btn:hover { background: var(--red-deep); }
  .btn.quiet { background: none; color: var(--ink-2); border: 1px solid var(--line); }
  .btn.quiet:hover { color: var(--ink); border-color: var(--ink-3); }
  .notice { border-left: 3px solid var(--brass); padding: 0.7rem 1rem; background: var(--surface); color: var(--ink-2); }
  .error { border-left: 3px solid var(--red); padding: 0.7rem 1rem; background: var(--surface); }
  .meta { font-size: 0.85rem; color: var(--ink-3); }
  .body { white-space: pre-wrap; overflow-wrap: anywhere; margin: 0.5rem 0 0; }
  code { font-size: 0.9em; }
</style>
